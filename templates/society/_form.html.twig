<div class="society-form-layout">
    {{ form_start(form, {
        attr: {
            action: action_path ?? '',
            class: 'js-society-form'
        }
    }) }}

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <div class="card h-100">
                <div class="card-body">

                    <div class="mb-4">
                        <h3 class="mb-1">{{ form_title|default('Société') }}</h3>
                        <p class="text-body-secondary mb-0">
                            {{ form_intro|default('Renseignez les informations principales et définissez si cette société est autonome ou rattachée à une société mère.') }}
                        </p>
                    </div>

                    {{ form_errors(form) }}

                    <div class="mb-4">
                        {{ form_label(form.name, 'Nom de la société', {
                            label_attr: {
                                class: 'form-label'
                            }
                        }) }}
                        {{ form_widget(form.name, {
                            attr: {
                                class: 'form-control form-control-lg',
                                placeholder: 'Ex. Commune de Sarry, Groupe Demo, Filiale Est...'
                            }
                        }) }}
                        <div class="form-text">
                            Utilisez un nom clair et métier, tel qu’il sera affiché dans les campagnes et les revues.
                        </div>
                        {{ form_errors(form.name) }}
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.parent, 'Société mère', {
                            label_attr: {
                                class: 'form-label'
                            }
                        }) }}
                        {{ form_widget(form.parent, {
                            attr: {
                                class: 'form-select form-select-lg'
                            }
                        }) }}
                        {{ form_errors(form.parent) }}
                        <div class="form-text mt-2">
                            Laissez vide pour créer une société racine. Sélectionnez une société mère pour créer une filiale.
                        </div>
                    </div>

                    <div class="society-highlight-box p-3 p-lg-4 mb-4">
                        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                            <div>
                                <div class="fw-semibold mb-1">Activation</div>
                                <div class="text-body-secondary small">
                                    Une société inactive reste historisée, mais n’est plus proposée dans les nouveaux parcours d’administration.
                                </div>
                            </div>

                            <div class="form-check form-switch m-0">
                                {{ form_widget(form.active, {
                                    attr: {
                                        class: 'form-check-input'
                                    }
                                }) }}
                                {{ form_label(form.active, 'Active', {
                                    label_attr: {
                                        class: 'form-check-label'
                                    }
                                }) }}
                            </div>
                        </div>

                        {{ form_errors(form.active) }}
                    </div>

                    <div class="society-actions d-flex justify-content-end gap-2">
                        <a href="{{ cancel_path ?? path('app_society_index') }}" class="btn btn-outline-secondary">
                            Annuler
                        </a>
                        <button class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>
                            {{ submit_label|default('Enregistrer') }}
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card h-100">
                <div class="card-body">

                    <div class="society-section-title">Aide</div>

                    <div class="d-flex gap-3 society-help-item">
                        <div class="society-help-icon">
                            <i class="bi bi-diagram-3"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">Société mère</div>
                            <div class="text-body-secondary small">
                                Une société sans société mère. Elle représente une entité principale ou autonome.
                            </div>
                        </div>
                        <div class="society-help-icon">
                            <i class="bi bi-arrow-return-right"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">Filiale</div>
                            <div class="text-body-secondary small">
                                Une société rattachée à une société mère. Elle pourra ensuite avoir ses propres campagnes.
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-3 society-help-item">
                        <div class="society-help-icon">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">Statut actif</div>
                            <div class="text-body-secondary small">
                                Activez la société pour la rendre disponible dans les écrans de gestion.
                            </div>
                        </div>
                    </div>

                    <div class="rounded-3 bg-body-tertiary border p-3 mt-4">
                        <div class="fw-semibold mb-2">Bonnes pratiques</div>
                        <ul class="small text-body-secondary mb-0 ps-3">
                            <li>Utiliser un nom court et explicite.</li>
                            <li>Éviter les doublons proches.</li>
                            <li>Rattacher uniquement si la hiérarchie est certaine.</li>
                            <li>Désactiver plutôt que supprimer si la société a déjà été utilisée.</li>
                        </ul>
                    </div>

                </div>
            </div>
        </div>
    </div>

    {{ form_end(form) }}
</div>
