{% extends 'layout/admin.html.twig' %}

{% block title %}Modifier la société{% endblock %}

{% block content %}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h3 class="mb-0">Modifier la société</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end mb-0">
                        <li class="breadcrumb-item">
                            <a href="{{ path('app_default') }}">Tableau de bord</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="{{ path('app_society_index') }}">Sociétés</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            Modifier
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">
            {{ include('society/_form.html.twig', {
                form_title: 'Modifier la société',
                form_intro: 'Mettez à jour les informations générales, le rattachement éventuel à une société mère et son statut d’activation.',
                submit_label: 'Enregistrer les modifications',
                cancel_path: path('app_society_index')
            }) }}
        </div>
    </div>
{% endblock %}

{% block stylesheet %}
    {{ parent() }}
    <style>
        /* ===== Society form ===== */

        .society-form-layout .card {
            border-radius: 1rem;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
        }

        .society-form-layout .card-body {
            padding: 2rem;
        }

        .society-form-layout .form-label {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: rgba(255, 255, 255, 0.92);
        }

        .society-form-layout .form-text {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9rem;
        }

        .society-form-layout .form-control,
        .society-form-layout .form-select {
            min-height: 3rem;
            border-radius: 0.85rem;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background-color: rgba(17, 24, 39, 0.55);
            color: #f8f9fa;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
        }

        .society-form-layout .form-control.form-control-lg,
        .society-form-layout .form-select.form-select-lg {
            min-height: 3.5rem;
            font-size: 1rem;
            padding-inline: 1rem;
        }

        .society-form-layout .form-control::placeholder {
            color: rgba(255, 255, 255, 0.38);
        }

        .society-form-layout .form-control:focus,
        .society-form-layout .form-select:focus {
            background-color: rgba(17, 24, 39, 0.72);
            border-color: rgba(59, 130, 246, 0.7);
            box-shadow: 0 0 0 0.22rem rgba(59, 130, 246, 0.16);
            color: #fff;
        }

        .society-form-layout .society-highlight-box {
            border-radius: 1rem;
            background: linear-gradient(180deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.02) 100%);
            border: 1px solid rgba(255, 255, 255, 0.07);
        }

        .society-form-layout .society-help-item + .society-help-item {
            margin-top: 1.25rem;
            padding-top: 1.25rem;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
        }

        .society-form-layout .society-help-icon {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 0.85rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(13, 110, 253, 0.12);
            color: #6ea8fe;
            flex-shrink: 0;
        }

        .society-form-layout .society-section-title {
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.55);
            margin-bottom: 1rem;
        }

        .society-form-layout .form-check.form-switch {
            padding-left: 0;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .society-form-layout .form-check-input {
            float: none;
            margin-left: 0;
            width: 3rem;
            height: 1.6rem;
            cursor: pointer;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background-color: rgba(255, 255, 255, 0.12);
            box-shadow: none;
        }

        .society-form-layout .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

        .society-form-layout .form-check-input:focus {
            box-shadow: 0 0 0 0.22rem rgba(13, 110, 253, 0.16);
        }

        .society-form-layout .form-check-label {
            margin-bottom: 0;
            font-weight: 600;
            cursor: pointer;
        }

        .society-form-layout .society-actions {
            margin-top: 2rem;
            padding-top: 1.25rem;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
        }

        .society-form-layout .btn {
            border-radius: 0.8rem;
            min-height: 2.75rem;
            padding-inline: 1rem;
        }

        .society-form-layout .btn-primary {
            box-shadow: 0 8px 20px rgba(13, 110, 253, 0.22);
        }

        .society-form-layout .invalid-feedback,
        .society-form-layout .form-error-message {
            display: block;
            margin-top: 0.4rem;
            font-size: 0.875rem;
        }

        @media (max-width: 1199.98px) {
            .society-form-layout .card-body {
                padding: 1.25rem;
            }
        }
    </style>
{% endblock %}
