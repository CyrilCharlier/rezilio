{% extends 'layout/admin.html.twig' %}

{% block title %}Campagnes{% endblock %}

{% block content %}
<div class="rz-page">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h3 class="mb-0">Campagnes</h3>
                    <p class="rz-page-intro">
                        Lancez une campagne à partir d’un référentiel et d’une société, puis suivez les campagnes déjà créées.
                    </p>
                </div>
                <div class="col-sm-6">
                    <div class="rz-page-actions mt-3 mt-sm-0">
                        <a href="{{ path('app_campaign_new') }}"
                            class="btn btn-primary rz-btn rz-btn-primary"
                            data-turbo="false"
                            rel="noopener noreferrer">
                            <i class="bi bi-plus-lg me-1"></i>
                            Nouvelle campagne
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">

            {{ include('partial/_flash_messages.html.twig') }}

            <div class="card rz-card rz-filter-card mb-4">
                <div class="card-header rz-card-header">
                    <div class="rz-card-header-title">
                        <i class="bi bi-funnel"></i>
                        <span>Filtres</span>
                    </div>
                </div>
                <div class="card-body rz-card-body">
                    <form method="get" class="row g-3 align-items-end">
                        <div class="col-12 col-md-5">
                            <label for="search" class="form-label rz-form-label">Recherche</label>
                            <input
                                type="text"
                                id="search"
                                name="search"
                                value="{{ filters.search|default('') }}"
                                class="form-control rz-form-control"
                                placeholder="Nom de campagne, société, référentiel..."
                            >
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="rz-toolbar">
                                <button class="btn btn-outline-secondary rz-btn" type="submit">
                                    <i class="bi bi-search me-1"></i>
                                    Rechercher
                                </button>
                                <a href="{{ path('app_campaign_index') }}" class="btn btn-outline-light rz-btn" data-turbo="false" rel="noopener noreferrer">
                                    Réinitialiser
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card rz-card">
                <div class="card-header rz-card-header">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="rz-card-header-title">
                            <i class="bi bi-clipboard-data"></i>
                            <span>Liste des campagnes</span>
                        </div>

                        {% if campaigns is not empty %}
                            <span class="rz-card-header-meta">
                                {{ campaigns|length }} campagne{{ campaigns|length > 1 ? 's' : '' }}
                            </span>
                        {% endif %}
                    </div>
                </div>

                {% if campaigns is not empty %}
                    <div class="card-body rz-card-body p-0">
                        <div class="rz-table-wrap">
                            <table class="table align-middle rz-table">
                                <thead>
                                    <tr>
                                        <th>Campagne</th>
                                        <th>Société</th>
                                        <th>Référentiel</th>
                                        <th>Date de début</th>
                                        <th>Date de fin</th>
                                        <th>Revues</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for campaign in campaigns %}
                                        <tr>
                                            <td>
                                                <div class="rz-table-title">{{ campaign.name }}</div>
                                            </td>
                                            <td>{{ campaign.society.name }}</td>
                                            <td>{{ campaign.referential.label }}</td>
                                            <td>{{ campaign.startDate ? campaign.startDate|date('d/m/Y') : '—' }}</td>
                                            <td>{{ campaign.endDate ? campaign.endDate|date('d/m/Y') : '—' }}</td>
                                            <td>
                                                <span class="badge text-bg-secondary">
                                                    {{ campaign.measureReviews|length }} revue{{ campaign.measureReviews|length > 1 ? 's' : '' }}
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group">
                                                    <a href="{{ path('app_campaign_show', {'id': campaign.id}) }}" class="btn btn-sm btn-outline-primary" data-turbo="false" rel="noopener noreferrer">
                                                        Ouvrir
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% else %}
                    <div class="card-body rz-card-body rz-empty">
                        <div>
                            <div class="rz-empty-icon">
                                <i class="bi bi-clipboard-data"></i>
                            </div>
                            <h4 class="rz-empty-title">Aucune campagne</h4>
                            <p class="rz-empty-text">
                                Créez votre première campagne pour lancer une revue de conformité sur une société et un référentiel.
                            </p>
                            <a href="{{ path('app_campaign_new') }}" class="btn btn-primary rz-btn rz-btn-primary" data-turbo="false" rel="noopener noreferrer">
                                <i class="bi bi-plus-lg me-1"></i>
                                Créer une campagne
                            </a>
                        </div>
                    </div>
                {% endif %}
            </div>

        </div>
    </div>
</div>
{% endblock %}
