{% extends 'layout/admin.html.twig' %}

{% block title %}{{ campaign.name }}{% endblock %}

{% block content %}
<div class="rz-page" id="rz-page-content">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row align-items-center g-3">
                <div class="col-sm-8">
                    <h3 class="mb-0">{{ campaign.name }}</h3>
                    <p class="rz-page-intro">
                        {{ campaign.society.name }} · {{ campaign.referential.label }}
                        {% if campaign.startDate %}
                            · démarrée le {{ campaign.startDate|date('d/m/Y') }}
                        {% endif %}
                    </p>
                </div>
                <div class="col-sm-4">
                    <div class="rz-page-actions mt-3 mt-sm-0">
                        <a href="{{ path('app_campaign_index') }}" class="btn btn-outline-light rz-btn">
                            Retour aux campagnes
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">
            {{ include('partial/_flash_messages.html.twig') }}

            {% set currentQuery = app.request.query.all %}
            {% set hasActiveFilters = filters.search or filters.category or filters.status or filters.applicability %}

            <div class="card rz-card rz-filter-bar mb-3 px-3" id="campaign-filter-bar">
                <div class="card-body rz-card-body rz-filter-bar-body">
                    <div class="rz-filter-bar-main">
                        <div class="rz-filter-bar-left">
                            <div class="rz-filter-bar-title">
                                <i class="bi bi-funnel" aria-hidden="true"></i>
                                <span>Filtres</span>
                            </div>

                            <div class="rz-filter-summary">
                                {% if filters.search %}
                                    <span class="rz-filter-pill">{{ filters.search }}</span>
                                {% endif %}
                                {% if filters.category %}
                                    <span class="rz-filter-pill">Catégorie</span>
                                {% endif %}
                                {% if filters.applicability == 'ee' %}
                                    <span class="rz-filter-pill">EE</span>
                                {% elseif filters.applicability == 'ei' %}
                                    <span class="rz-filter-pill">EI</span>
                                {% endif %}
                                {% if filters.status %}
                                    <span class="rz-filter-pill">
                                        {% for statusKey, column in columns %}
                                            {% if column.value == filters.status %}
                                                {{ column.label }}
                                            {% endif %}
                                        {% endfor %}
                                    </span>
                                {% endif %}
                                {% if not hasActiveFilters %}
                                    <span class="rz-filter-summary-empty">Aucun filtre actif</span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="rz-filter-bar-actions">
                            <button
                                class="btn btn-outline-light rz-btn"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#campaignFilters"
                                aria-expanded="{{ hasActiveFilters ? 'true' : 'false' }}"
                                aria-controls="campaignFilters"
                            >
                                <i class="bi bi-sliders me-1" aria-hidden="true"></i>
                                Filtres
                            </button>

                            <a href="{{ path('app_campaign_show', {'id': campaign.id}) }}" class="btn btn-outline-light rz-btn">
                                Réinitialiser
                            </a>
                        </div>
                    </div>

                    <div class="collapse {{ hasActiveFilters ? 'show' : '' }}" id="campaignFilters">
                        <form method="get" class="rz-filter-panel">
                            <div class="rz-filter-main">
                                <div class="rz-filter-search">
                                    <label for="search" class="form-label rz-form-label">Recherche</label>
                                    <input
                                        type="text"
                                        id="search"
                                        name="search"
                                        value="{{ filters.search }}"
                                        class="form-control rz-form-control"
                                        placeholder="Code, mesure, catégorie..."
                                    >
                                </div>

                                <div class="rz-filter-category">
                                    <label for="category" class="form-label rz-form-label">Catégorie</label>
                                    <select id="category" name="category" class="form-select rz-form-select">
                                        <option value="">Toutes</option>
                                        {% for category in categories %}
                                            <option value="{{ category.id }}" {{ filters.category == category.id ? 'selected' : '' }}>
                                                {{ category.name }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>

                                <div class="rz-filter-actions-inline">
                                    <button class="btn btn-primary rz-btn rz-btn-primary" type="submit">
                                        <i class="bi bi-search me-1" aria-hidden="true"></i>
                                        Appliquer
                                    </button>
                                </div>
                            </div>

                            <div class="rz-filter-groups">
                                <div class="rz-filter-group">
                                    <span class="rz-filter-group-label">Applicabilité</span>
                                    <div class="rz-quick-filters">
                                        <a
                                            href="{{ path('app_campaign_show', {'id': campaign.id}|merge(currentQuery)|merge({'applicability': null})) }}"
                                            class="rz-chip {{ filters.applicability is empty ? 'is-active' : '' }}"
                                        >
                                            Toutes
                                        </a>
                                        <a
                                            href="{{ path('app_campaign_show', {'id': campaign.id}|merge(currentQuery)|merge({'applicability': 'ee'})) }}"
                                            class="rz-chip {{ filters.applicability == 'ee' ? 'is-active' : '' }}"
                                        >
                                            EE
                                        </a>
                                        <a
                                            href="{{ path('app_campaign_show', {'id': campaign.id}|merge(currentQuery)|merge({'applicability': 'ei'})) }}"
                                            class="rz-chip {{ filters.applicability == 'ei' ? 'is-active' : '' }}"
                                        >
                                            EI
                                        </a>
                                    </div>
                                </div>

                                <div class="rz-filter-group">
                                    <span class="rz-filter-group-label">Statut</span>
                                    <div class="rz-quick-filters">
                                        <a
                                            href="{{ path('app_campaign_show', {'id': campaign.id}|merge(currentQuery)|merge({'status': null})) }}"
                                            class="rz-chip {{ filters.status is empty ? 'is-active' : '' }}"
                                        >
                                            Tous
                                        </a>
                                        {% for statusKey, column in columns %}
                                            <a
                                                href="{{ path('app_campaign_show', {'id': campaign.id}|merge(currentQuery)|merge({'status': column.value})) }}"
                                                class="rz-chip {{ filters.status == column.value ? 'is-active' : '' }}"
                                            >
                                                {{ column.label }}
                                            </a>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="rz-kanban-board rz-kanban-board-compact" id="rz-kanban-board">
                {% for statusKey, column in columns %}
                    <section
                        class="rz-kanban-column"
                        data-status-key="{{ statusKey }}"
                        data-status-value="{{ column.value }}"
                        aria-label="Colonne {{ column.label }}"
                    >
                        <div class="card rz-card rz-kanban-panel">
                            <div class="card-header rz-card-header rz-kanban-column-header rz-kanban-column-header-compact">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <span class="rz-kanban-column-title">{{ column.label }}</span>
                                    <span class="badge text-bg-secondary" data-column-count>{{ column.items|length }}</span>
                                </div>
                            </div>

                            <div class="card-body rz-card-body rz-kanban-column-body"
                                 data-dropzone
                                 data-status-key="{{ statusKey }}"
                                 data-status-value="{{ column.value }}">
                                <div class="rz-kanban-cards">
                                    {% for review in column.items %}
                                        {% set node = review.measure %}
                                        <article
                                            class="rz-kanban-card rz-kanban-card-compact"
                                            draggable="true"
                                            tabindex="0"
                                            role="button"
                                            aria-label="Ouvrir la revue {{ node.code }} {{ node.label }}"
                                            data-review-id="{{ review.id }}"
                                            data-current-status="{{ review.status.value }}"
                                            data-move-url="{{ path('app_measure_review_move', {'id': review.id}) }}"
                                            data-modal-url="{{ path('app_measure_review_modal', {'id': review.id}) }}"
                                            data-csrf-token="{{ csrf_token('measure_review_status_' ~ review.id) }}"
                                        >
                                            <div class="rz-kanban-card-top">
                                                <div class="rz-kanban-card-code">{{ node.code }}</div>
                                                <div class="rz-kanban-card-open" aria-hidden="true">
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                </div>
                                            </div>

                                            <h5 class="rz-kanban-card-title rz-clamp-2">
                                                {{ node.label }}
                                            </h5>

                                            <div class="rz-kanban-card-meta">
                                                {% if node.category %}
                                                    <span class="badge text-bg-dark">{{ node.category.name }}</span>
                                                {% endif %}
                                                {% if node.appliesToEE %}
                                                    <span class="badge text-bg-primary">EE</span>
                                                {% endif %}
                                                {% if node.appliesToEI %}
                                                    <span class="badge text-bg-info">EI</span>
                                                {% endif %}
                                            </div>

                                            {% if review.explanation %}
                                                <p class="rz-kanban-card-text rz-clamp-2">
                                                    {{ review.explanation }}
                                                </p>
                                            {% endif %}
                                        </article>
                                    {% endfor %}
                                </div>

                                <div class="rz-empty-mini {{ column.items is not empty ? 'd-none' : '' }}" data-empty-state>
                                    <div class="rz-empty-mini-icon">
                                        <i class="bi bi-inbox" aria-hidden="true"></i>
                                    </div>
                                    <div class="rz-empty-mini-text">
                                        Aucune revue dans cette colonne.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                {% endfor %}
            </div>

            <div id="rz-toast-stack" class="rz-toast-stack" aria-live="polite" aria-atomic="true"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="measureReviewModal" tabindex="-1" aria-labelledby="measureReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable rz-modal-xxl">
        <div class="modal-content rz-modal-content rz-modal-shell">
            <div class="modal-header rz-modal-shell-header">
                <h5 class="modal-title" id="measureReviewModalLabel">Revue de mesure</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>

            <div class="modal-body rz-modal-shell-body" id="measureReviewModalBody">
                <div class="rz-modal-loading">Chargement…</div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheet %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/rezilio-campaign-show.css">
{% endblock %}

{% block javascript %}
    {{ parent() }}
    <script src="/js/rezilio-campaign-show.js"></script>
{% endblock %}
