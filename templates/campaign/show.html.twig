{% extends 'layout/admin.html.twig' %}

{% block title %}{{ campaign.name }}{% endblock %}

{% block content %}
<div class="rz-page" id="rz-page-content">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row align-items-center g-3">
                <div class="col-sm-8">
                    <h3 class="mb-0">{{ campaign.name }}</h3>
                    <p class="rz-page-intro">
                        {{ campaign.society.name }} · {{ campaign.referential.label }}
                        {% if campaign.startDate %}
                            · démarrée le {{ campaign.startDate|date('d/m/Y') }}
                        {% endif %}
                    </p>
                </div>
                <div class="col-sm-4">
                    <div class="rz-page-actions mt-3 mt-sm-0">
                        <a href="{{ path('app_campaign_index') }}" class="btn btn-outline-light rz-btn">
                            Retour aux campagnes
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">

            {{ include('partial/_flash_messages.html.twig') }}

            {% set currentQuery = app.request.query.all %}
            {% set hasActiveFilters = filters.search or filters.category or filters.status or filters.applicability %}

            <div class="card rz-card rz-filter-bar mb-3" id="campaign-filter-bar">
                <div class="card-body rz-card-body rz-filter-bar-body">
                    <div class="rz-filter-bar-main">
                        <div class="rz-filter-bar-left">
                            <div class="rz-filter-bar-title">
                                <i class="bi bi-funnel"></i>
                                <span>Filtres</span>
                            </div>

                            <div class="rz-filter-summary">
                                {% if filters.search %}
                                    <span class="rz-filter-pill">{{ filters.search }}</span>
                                {% endif %}
                                {% if filters.category %}
                                    <span class="rz-filter-pill">Catégorie</span>
                                {% endif %}
                                {% if filters.applicability == 'ee' %}
                                    <span class="rz-filter-pill">EE</span>
                                {% elseif filters.applicability == 'ei' %}
                                    <span class="rz-filter-pill">EI</span>
                                {% endif %}
                                {% if filters.status %}
                                    <span class="rz-filter-pill">
                                        {% for statusKey, column in columns %}
                                            {% if column.value == filters.status %}
                                                {{ column.label }}
                                            {% endif %}
                                        {% endfor %}
                                    </span>
                                {% endif %}
                                {% if not hasActiveFilters %}
                                    <span class="rz-filter-summary-empty">Aucun filtre actif</span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="rz-filter-bar-actions">
                            <button
                                class="btn btn-outline-light rz-btn"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#campaignFilters"
                                aria-expanded="{{ hasActiveFilters ? 'true' : 'false' }}"
                                aria-controls="campaignFilters"
                            >
                                <i class="bi bi-sliders me-1"></i>
                                Filtres
                            </button>

                            <a href="{{ path('app_campaign_show', {'id': campaign.id}) }}" class="btn btn-outline-light rz-btn">
                                Réinitialiser
                            </a>
                        </div>
                    </div>

                    <div class="collapse {{ hasActiveFilters ? 'show' : '' }}" id="campaignFilters">
                        <form method="get" class="rz-filter-panel">
                            <div class="rz-filter-main">
                                <div class="rz-filter-search">
                                    <label for="search" class="form-label rz-form-label">Recherche</label>
                                    <input
                                        type="text"
                                        id="search"
                                        name="search"
                                        value="{{ filters.search }}"
                                        class="form-control rz-form-control"
                                        placeholder="Code, mesure, catégorie..."
                                    >
                                </div>

                                <div class="rz-filter-category">
                                    <label for="category" class="form-label rz-form-label">Catégorie</label>
                                    <select id="category" name="category" class="form-select rz-form-select">
                                        <option value="">Toutes</option>
                                        {% for category in categories %}
                                            <option value="{{ category.id }}" {{ filters.category == category.id ? 'selected' : '' }}>
                                                {{ category.name }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>

                                <div class="rz-filter-actions-inline">
                                    <button class="btn btn-primary rz-btn rz-btn-primary" type="submit">
                                        <i class="bi bi-search me-1"></i>
                                        Appliquer
                                    </button>
                                </div>
                            </div>

                            <div class="rz-filter-groups">
                                <div class="rz-filter-group">
                                    <span class="rz-filter-group-label">Applicabilité</span>
                                    <div class="rz-quick-filters">
                                        <a
                                            href="{{ path('app_campaign_show', {'id': campaign.id}|merge(currentQuery)|merge({'applicability': null})) }}"
                                            class="rz-chip {{ filters.applicability is empty ? 'is-active' : '' }}"
                                        >
                                            Toutes
                                        </a>
                                        <a
                                            href="{{ path('app_campaign_show', {'id': campaign.id}|merge(currentQuery)|merge({'applicability': 'ee'})) }}"
                                            class="rz-chip {{ filters.applicability == 'ee' ? 'is-active' : '' }}"
                                        >
                                            EE
                                        </a>
                                        <a
                                            href="{{ path('app_campaign_show', {'id': campaign.id}|merge(currentQuery)|merge({'applicability': 'ei'})) }}"
                                            class="rz-chip {{ filters.applicability == 'ei' ? 'is-active' : '' }}"
                                        >
                                            EI
                                        </a>
                                    </div>
                                </div>

                                <div class="rz-filter-group">
                                    <span class="rz-filter-group-label">Statut</span>
                                    <div class="rz-quick-filters">
                                        <a
                                            href="{{ path('app_campaign_show', {'id': campaign.id}|merge(currentQuery)|merge({'status': null})) }}"
                                            class="rz-chip {{ filters.status is empty ? 'is-active' : '' }}"
                                        >
                                            Tous
                                        </a>
                                        {% for statusKey, column in columns %}
                                            <a
                                                href="{{ path('app_campaign_show', {'id': campaign.id}|merge(currentQuery)|merge({'status': column.value})) }}"
                                                class="rz-chip {{ filters.status == column.value ? 'is-active' : '' }}"
                                            >
                                                {{ column.label }}
                                            </a>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="rz-kanban-board rz-kanban-board-compact" id="rz-kanban-board">
                {% for statusKey, column in columns %}
                    <section
                        class="rz-kanban-column"
                        data-status-key="{{ statusKey }}"
                        data-status-value="{{ column.value }}"
                    >
                        <div class="card rz-card rz-kanban-panel">
                            <div class="card-header rz-card-header rz-kanban-column-header rz-kanban-column-header-compact">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <span class="rz-kanban-column-title">{{ column.label }}</span>
                                    <span class="badge text-bg-secondary" data-column-count>{{ column.items|length }}</span>
                                </div>
                            </div>

                            <div class="card-body rz-card-body rz-kanban-column-body"
                                 data-dropzone
                                 data-status-key="{{ statusKey }}"
                                 data-status-value="{{ column.value }}">
                                <div class="rz-kanban-cards">
                                    {% for review in column.items %}
                                        {% set node = review.measure %}
                                        <article
                                            class="rz-kanban-card rz-kanban-card-compact"
                                            draggable="true"
                                            tabindex="0"
                                            role="button"
                                            data-review-id="{{ review.id }}"
                                            data-current-status="{{ review.status.value }}"
                                            data-move-url="{{ path('app_measure_review_move', {'id': review.id}) }}"
                                            data-modal-url="{{ path('app_measure_review_modal', {'id': review.id}) }}"
                                            data-csrf-token="{{ csrf_token('measure_review_status_' ~ review.id) }}"
                                        >
                                            <div class="rz-kanban-card-top">
                                                <div class="rz-kanban-card-code">{{ node.code }}</div>
                                                <div class="rz-kanban-card-open">
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                </div>
                                            </div>

                                            <h5 class="rz-kanban-card-title rz-clamp-2">
                                                {{ node.label }}
                                            </h5>

                                            <div class="rz-kanban-card-meta">
                                                {% if node.category %}
                                                    <span class="badge text-bg-dark">{{ node.category.name }}</span>
                                                {% endif %}
                                                {% if node.appliesToEE %}
                                                    <span class="badge text-bg-primary">EE</span>
                                                {% endif %}
                                                {% if node.appliesToEI %}
                                                    <span class="badge text-bg-info">EI</span>
                                                {% endif %}
                                            </div>

                                            {% if review.explanation %}
                                                <p class="rz-kanban-card-text rz-clamp-2">
                                                    {{ review.explanation }}
                                                </p>
                                            {% endif %}
                                        </article>
                                    {% endfor %}
                                </div>

                                <div class="rz-empty-mini {{ column.items is not empty ? 'd-none' : '' }}" data-empty-state>
                                    <div class="rz-empty-mini-icon">
                                        <i class="bi bi-inbox"></i>
                                    </div>
                                    <div class="rz-empty-mini-text">
                                        Aucune revue dans cette colonne.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                {% endfor %}
            </div>

            <div id="rz-toast-stack" class="rz-toast-stack" aria-live="polite" aria-atomic="true"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="measureReviewModal" tabindex="-1" aria-labelledby="measureReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable rz-modal-xxl">
        <div class="modal-content rz-modal-content rz-modal-shell">
            <div class="modal-header rz-modal-shell-header">
                <h5 class="modal-title" id="measureReviewModalLabel">Revue de mesure</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>

            <div class="modal-body rz-modal-shell-body" id="measureReviewModalBody">
                <div class="rz-modal-loading">Chargement…</div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheet %}
    {{ parent() }}
<style>
    /* Barre de filtres */

    .rz-filter-bar {
        position: sticky;
        top: 0.75rem;
        z-index: 20;
        backdrop-filter: blur(10px);
    }

    .rz-filter-bar-body {
        padding-top: 0.85rem;
        padding-bottom: 0.85rem;
    }

    .rz-filter-bar-main {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .rz-filter-bar-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        min-width: 0;
    }

    .rz-filter-bar-title {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        color: #fff;
        white-space: nowrap;
    }

    .rz-filter-summary {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        min-width: 0;
    }

    .rz-filter-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.3rem 0.65rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.82);
        font-size: 0.78rem;
        line-height: 1;
    }

    .rz-filter-summary-empty {
        color: rgba(255, 255, 255, 0.56);
        font-size: 0.84rem;
    }

    .rz-filter-bar-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
    }

    .rz-filter-panel {
        margin-top: 0.9rem;
        padding-top: 0.9rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .rz-filter-main {
        display: grid;
        grid-template-columns: minmax(320px, 2fr) minmax(220px, 1fr) auto;
        gap: 1rem;
        align-items: end;
    }

    .rz-filter-actions-inline {
        display: flex;
        align-items: end;
        justify-content: flex-start;
    }

    .rz-filter-groups {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2rem;
    }

    .rz-filter-group {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .rz-filter-group-label {
        font-size: 0.76rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.52);
    }

    .rz-quick-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }

    .rz-chip {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.72rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.02);
        color: rgba(255, 255, 255, 0.78);
        text-decoration: none;
        font-size: 0.82rem;
        line-height: 1;
        transition: all 0.18s ease;
    }

    .rz-chip:hover,
    .rz-chip.is-active {
        color: #fff;
        border-color: rgba(73, 140, 255, 0.42);
        background: rgba(73, 140, 255, 0.14);
    }

    /* Kanban */

    .rz-kanban-meta {
        display: flex;
        justify-content: flex-end;
        align-items: center;
    }

    .rz-kanban-count {
        color: rgba(255, 255, 255, 0.72);
        font-size: 0.92rem;
    }

    .rz-kanban-board {
        display: grid;
        grid-template-columns: repeat(4, minmax(260px, 1fr));
        gap: 1rem;
        align-items: start;
    }

    .rz-kanban-panel {
        height: calc(100vh - 270px);
        min-height: 500px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .rz-kanban-column-header-compact {
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
        position: sticky;
        top: 0;
        z-index: 2;
        background: var(--bs-card-cap-bg, rgba(255, 255, 255, 0.02));
        backdrop-filter: blur(8px);
    }

    .rz-kanban-column-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: #fff;
    }

    .rz-kanban-column-body {
        flex: 1;
        overflow-y: auto;
        min-height: 0;
        padding-right: 0.55rem;
        padding-top: 0.7rem;
    }

    .rz-kanban-column-body::-webkit-scrollbar {
        width: 8px;
    }

    .rz-kanban-column-body::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.14);
        border-radius: 999px;
    }

    .rz-kanban-cards {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        min-height: 2rem;
    }

    .rz-kanban-card-compact {
        padding: 0.8rem 0.85rem;
        border-radius: 0.85rem;
        border: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(255, 255, 255, 0.025);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        cursor: grab;
        user-select: none;
        transition:
            transform 140ms ease,
            box-shadow 140ms ease,
            border-color 140ms ease,
            opacity 140ms ease;
    }

    .rz-kanban-card-compact:hover {
        border-color: rgba(73, 140, 255, 0.25);
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.16);
    }

    .rz-kanban-card-compact:focus-visible {
        outline: 2px solid rgba(73, 140, 255, 0.9);
        outline-offset: 2px;
    }

    .rz-kanban-card-compact:active {
        cursor: grabbing;
    }

    .rz-kanban-card-compact.is-dragging {
        opacity: 0.45;
        transform: rotate(1deg) scale(0.99);
        cursor: grabbing;
    }

    .rz-kanban-column-body.is-drop-target {
        outline: 1px dashed rgba(73, 140, 255, 0.55);
        outline-offset: -6px;
        background: rgba(73, 140, 255, 0.05);
        border-radius: 0.85rem;
    }

    .rz-kanban-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.4rem;
    }

    .rz-kanban-card-code {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.56);
    }

    .rz-kanban-card-open {
        color: rgba(255, 255, 255, 0.44);
        font-size: 0.85rem;
    }

    .rz-kanban-card-title {
        font-size: 0.92rem;
        font-weight: 700;
        line-height: 1.28;
        color: #fff;
        margin-bottom: 0.42rem;
    }

    .rz-kanban-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.32rem;
        margin-bottom: 0.55rem;
    }

    .rz-kanban-card-meta .badge {
        font-size: 0.66rem;
        font-weight: 600;
    }

    .rz-kanban-card-text {
        margin: 0;
        font-size: 0.82rem;
        line-height: 1.4;
        color: rgba(255, 255, 255, 0.68);
    }

    .rz-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-clamp: 2;
    }

    .rz-empty-mini {
        min-height: 160px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: rgba(255, 255, 255, 0.58);
    }

    .rz-empty-mini-icon {
        font-size: 1.35rem;
        margin-bottom: 0.45rem;
    }

    /* Toasts */

    .rz-toast-stack {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 1080;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        pointer-events: none;
    }

    .rz-toast {
        min-width: 280px;
        max-width: 360px;
        padding: 0.85rem 1rem;
        border-radius: 0.85rem;
        color: #fff;
        background: rgba(24, 28, 37, 0.96);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
        opacity: 0;
        transform: translateY(-8px);
        transition: opacity 180ms ease, transform 180ms ease;
        pointer-events: auto;
    }

    .rz-toast.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .rz-toast--success {
        border-color: rgba(80, 200, 120, 0.35);
    }

    .rz-toast--error {
        border-color: rgba(255, 90, 90, 0.35);
    }

    /* Coque de modale */

    .rz-modal-content {
        background: linear-gradient(180deg, #1f2430 0%, #1c2230 100%);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 22px 48px rgba(0, 0, 0, 0.38);
    }

    #measureReviewModal .modal-header {
        padding: 1rem 1.15rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.02);
    }

    #measureReviewModal .modal-title {
        font-size: 1.08rem;
        font-weight: 700;
        color: #fff;
    }

    #measureReviewModal .btn-close {
        filter: invert(1) grayscale(1);
        opacity: 0.85;
    }

    #measureReviewModal .btn-close:hover {
        opacity: 1;
    }

    .rz-modal-loading {
        color: rgba(255, 255, 255, 0.7);
    }

    /* Modale XXL split gauche/droite */

    .rz-modal-xxl {
        width: min(96vw, 1800px);
        max-width: none;
        height: 94vh;
        margin: 3vh auto;
    }

    .rz-modal-shell {
        height: 100%;
        min-height: 0;
        border-radius: 1rem;
        overflow: hidden;
    }

    .rz-modal-shell-header {
        flex: 0 0 auto;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.02);
    }

    .rz-modal-shell-body {
        flex: 1 1 auto;
        min-height: 0;
        padding: 0 !important;
        overflow: hidden;
        height: calc(94vh - 72px);
    }

    #measureReviewModal .modal-content {
        height: 100%;
    }

    #measureReviewModal .modal-body {
        padding: 0;
    }

    .rz-modal-review-layout {
        display: grid;
        grid-template-columns: minmax(520px, 0.95fr) minmax(620px, 1.25fr);
        height: 100%;
        min-height: 0;
    }

    .rz-modal-pane {
        min-width: 0;
        min-height: 0;
        overflow: hidden;
    }

    .rz-modal-pane-review {
        position: relative;
        border-right: 1px solid rgba(255, 255, 255, 0.10);
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.02) 0%, rgba(255, 255, 255, 0.01) 100%);
        box-shadow:
            inset -1px 0 0 rgba(255, 255, 255, 0.04),
            inset -24px 0 32px rgba(0, 0, 0, 0.14);
    }

    .rz-modal-pane-review::after {
        content: "";
        position: absolute;
        top: 0;
        right: -1px;
        width: 1px;
        height: 100%;
        background: linear-gradient(
            180deg,
            rgba(255,255,255,0.04) 0%,
            rgba(255,255,255,0.14) 12%,
            rgba(255,255,255,0.14) 88%,
            rgba(255,255,255,0.04) 100%
        );
        pointer-events: none;
    }

    .rz-modal-pane-remediation {
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.018) 0%, rgba(255, 255, 255, 0.008) 100%);
    }

    .rz-modal-pane-inner {
        height: 100%;
        min-height: 0;
        overflow-y: auto;
        padding: 1.25rem 1.25rem 1.4rem;
    }

    .rz-modal-pane-inner::-webkit-scrollbar {
        width: 10px;
    }

    .rz-modal-pane-inner::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.12);
        border-radius: 999px;
    }

    .rz-modal-review-head {
        margin-bottom: 1.25rem;
        padding: 1.1rem 1.1rem 1rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1rem;
        background:
            linear-gradient(180deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.04),
            0 10px 24px rgba(0, 0, 0, 0.12);
    }

    .rz-modal-review-kicker {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        flex-wrap: wrap;
        margin-bottom: 0.85rem;
    }

    .rz-modal-review-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.42rem 0.7rem;
