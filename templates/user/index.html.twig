{# templates/admin/user/index.html.twig #}
{% extends 'layout/admin.html.twig' %}

{% block title %}Administration des utilisateurs{% endblock %}

{% block content %}
<div class="rz-page">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h3 class="mb-0">Utilisateurs</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end mb-0">
                        <li class="breadcrumb-item">
                            <a href="{{ path('app_default') }}">Tableau de bord</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            Utilisateurs
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">
            {{ include('partial/_flash_messages.html.twig') }}

            <div class="card rz-card">
                <div class="card-header rz-card-header">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="rz-card-header-title">
                            <i class="bi bi-people"></i>
                            <span>Liste des utilisateurs</span>
                        </div>

                        <button
                            type="button"
                            class="btn btn-primary rz-btn rz-btn-primary"
                            id="rz-user-new-btn"
                            data-url="{{ path('admin_user_new') }}"
                        >
                            <i class="bi bi-plus-lg me-1"></i>
                            Nouvel utilisateur
                        </button>
                    </div>
                </div>

                {% if users is not empty %}
                    <div class="card-body rz-card-body p-0">
                        <div class="rz-table-wrap">
                            <table class="table align-middle rz-table">
                                <thead>
                                    <tr>
                                        <th style="width: 70px;">ID</th>
                                        <th>E-mail</th>
                                        <th>Rôles</th>
                                        <th>Dernière connexion</th>
                                        <th>Désactivé le</th>
                                        <th>Actif</th>
                                        <th class="text-end" style="width: 170px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for user in users %}
                                        {% set rowClass = '' %}

                                        {% if user.deactivatedAt is not null %}
                                            {% set nowTs = "now"|date('U') %}
                                            {% set deactivatedTs = user.deactivatedAt|date('U') %}
                                            {% set daysSinceDeactivation = ((nowTs - deactivatedTs) / 86400)|round(0, 'floor') %}

                                            {% if daysSinceDeactivation >= 15 and daysSinceDeactivation < 30 %}
                                                {% set rowClass = 'rz-user-row-warn' %}
                                            {% elseif daysSinceDeactivation >= 30 and daysSinceDeactivation < 45 %}
                                                {% set rowClass = 'rz-user-row-danger' %}
                                            {% endif %}
                                        {% endif %}

                                        <tr class="{{ rowClass }}">
                                            <td class="text-body-secondary">
                                                {% if user.deactivatedAt is not null and daysSinceDeactivation >= 30 and daysSinceDeactivation < 45 %}
                                                    <i class="bi bi-exclamation-circle text-warning me-1"></i>
                                                {% elseif user.deactivatedAt is not null and daysSinceDeactivation >= 15 and daysSinceDeactivation < 30 %}
                                                    <i class="bi bi-clock-history text-muted me-1"></i>
                                                {% endif %}
                                                {{ user.id }}
                                            </td>
                                            <td>
                                                <div class="rz-table-title">
                                                    {{ user.userIdentifier }}
                                                </div>
                                            </td>
                                            <td class="text-body-secondary">
                                                {% if user.roles is defined and user.roles is not empty %}
                                                    {% for role in user.roles %}
                                                        <span class="badge text-bg-secondary me-1">
                                                            {{ role }}
                                                        </span>
                                                    {% endfor %}
                                                {% else %}
                                                    <span class="text-body-secondary">—</span>
                                                {% endif %}
                                            </td>

                                            <td class="text-body-secondary">
                                                {% if user.lastLoginAt is not null %}
                                                    <span title="{{ user.lastLoginAt|date('d/m/Y H:i:s') }}">
                                                        {{ user.lastLoginAt|date('d/m/Y') }}
                                                    </span>
                                                {% else %}
                                                    <span class="text-muted fst-italic">
                                                        Jamais connecté
                                                    </span>
                                                {% endif %}
                                            </td>

                                            <td class="text-body-secondary">
                                                {% if user.deactivatedAt is not null %}
                                                    <span title="{{ user.deactivatedAt|date('d/m/Y H:i:s') }}">
                                                        {{ user.deactivatedAt|date('d/m/Y') }}
                                                    </span>
                                                {% else %}
                                                    <span class="text-muted">—</span>
                                                {% endif %}
                                            </td>

                                            <td data-user-status-cell="{{ user.id }}">
                                                {% if user.isActive() %}
                                                    <span class="badge text-bg-success">Oui</span>
                                                {% else %}
                                                    <span class="badge text-bg-secondary">Non</span>
                                                {% endif %}
                                            </td>

                                            <td class="text-end">
                                                <div class="d-inline-flex align-items-center gap-1">
                                                    <button type="button"
                                                            class="btn btn-outline-secondary btn-sm rz-user-edit-btn"
                                                            data-url="{{ path('admin_user_edit', {'id': user.id}) }}"
                                                            title="Modifier">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>

                                                    <button
                                                        type="button"
                                                        class="btn btn-sm rz-user-toggle-status-btn {{ user.isActive() ? 'btn-outline-warning' : 'btn-outline-success' }}"
                                                        data-user-id="{{ user.id }}"
                                                        data-url="{{ path('admin_user_toggle_status', {'id': user.id}) }}"
                                                        data-token="{{ csrf_token('toggle_user_status_' ~ user.id) }}"
                                                        title="{{ user.isActive() ? 'Désactiver l’utilisateur' : 'Activer l’utilisateur' }}"
                                                    >
                                                        {% if user.isActive() %}
                                                            <i class="bi bi-person-x"></i>
                                                        {% else %}
                                                            <i class="bi bi-person-check"></i>
                                                        {% endif %}
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% else %}
                    <div class="card-body rz-card-body rz-empty">
                        <div>
                            <div class="rz-empty-icon">
                                <i class="bi bi-people"></i>
                            </div>
                            <h4 class="rz-empty-title">Aucun utilisateur</h4>
                            <p class="rz-empty-text">
                                Créez votre premier utilisateur pour donner accès à Rezilio
                                et gérer les responsabilités de conformité.
                            </p>
                            <button
                                type="button"
                                class="btn btn-primary rz-btn rz-btn-primary"
                                id="rz-user-new-btn-empty"
                                data-url="{{ path('admin_user_new') }}"
                            >
                                <i class="bi bi-plus-lg me-1"></i>
                                Créer un utilisateur
                            </button>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rz-user-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content" id="rz-user-modal-content"></div>
  </div>
</div>
{% endblock %}

{% block stylesheet %}
<style>
.rz-user-row-warn {
    --bs-table-bg-state: rgba(255, 193, 7, 0.06);
    box-shadow: inset 3px 0 0 rgba(255, 193, 7, 0.6);
}

.rz-user-row-danger {
    --bs-table-bg-state: rgba(220, 53, 69, 0.06);
    box-shadow: inset 3px 0 0 rgba(220, 53, 69, 0.7);
}

.rz-user-row-warn:hover,
.rz-user-row-danger:hover {
    --bs-table-bg-state: rgba(255, 255, 255, 0.03);
}

.rz-user-societies-section .rz-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
}

.rz-user-society-table {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
}

.rz-user-society-table__head {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr) 46px;
    gap: 0.75rem;
    padding: 0 0.2rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.rz-user-society-table__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 320px;
    overflow-y: auto;
    padding-right: 0.2rem;
}

.rz-user-society-table__row {
    padding: 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.8rem;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.18s ease, background-color 0.18s ease;
}

.rz-user-society-table__row:hover {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.03);
}

.rz-user-society-table__row-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr) 46px;
    gap: 0.75rem;
    align-items: center;
}

.rz-user-society-table__row-grid > div {
    min-width: 0;
}

.rz-user-society-table__row .form-select,
.rz-user-society-table__row .form-control,
.rz-user-society-table__row .rz-form-select,
.rz-user-society-table__row .rz-form-control,
.rz-user-society-table__body .form-select,
.rz-user-society-table__body .form-control,
.rz-user-society-table__body .rz-form-select,
.rz-user-society-table__body .rz-form-control {
    min-height: 2.45rem;
    height: 2.45rem;
    padding-top: 0.35rem;
    padding-bottom: 0.35rem;
    border-radius: 0.65rem;
    margin: 0;
    font-size: 0.98rem;
}

.rz-user-society-table__row .invalid-feedback,
.rz-user-society-table__body .invalid-feedback {
    margin-top: 0.25rem;
    font-size: 0.78rem;
}

.rz-user-society-table__actions {
    display: flex;
    align-items: center;
    justify-content: center;
}

.rz-user-society-table__remove {
    width: 2.45rem;
    min-width: 2.45rem;
    height: 2.45rem;
    border-radius: 0.65rem;
    border: 1px solid rgba(220, 53, 69, 0.16);
    background: rgba(220, 53, 69, 0.05);
    color: rgba(255, 201, 207, 0.92);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
}

.rz-user-society-table__remove:hover {
    background: rgba(220, 53, 69, 0.11);
    border-color: rgba(220, 53, 69, 0.26);
    color: #fff;
}

.rz-user-societies-add {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0;
    margin-top: 0.1rem;
    color: #6ea8fe;
    font-weight: 500;
    text-decoration: none;
    font-size: 0.98rem;
}

.rz-user-societies-add:hover {
    color: #9ec5fe;
    text-decoration: none;
}

.rz-user-societies-empty {
    padding: 0.8rem 0.9rem;
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: 0.8rem;
    background: rgba(255, 255, 255, 0.015);
}

.rz-user-societies-empty__title {
    color: rgba(255, 255, 255, 0.92);
    font-weight: 600;
    margin-bottom: 0.15rem;
    font-size: 0.95rem;
}

.rz-user-societies-empty__text {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.84rem;
    line-height: 1.35;
}

@media (max-width: 767.98px) {
    .rz-user-society-table__head {
        display: none;
    }

    .rz-user-society-table__row-grid {
        grid-template-columns: 1fr;
        gap: 0.6rem;
    }

    .rz-user-society-table__actions {
        justify-content: flex-start;
    }

    .rz-user-society-table__remove {
        width: 2.35rem;
        min-width: 2.35rem;
        height: 2.35rem;
    }
}

.rz-role-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
}

.rz-role-option {
    position: relative;
}

.rz-role-option__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}

.rz-role-option__label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.6rem;
    padding: 0.65rem 1rem;
    border-radius: 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.10);
    background: rgba(255, 255, 255, 0.02);
    color: rgba(255, 255, 255, 0.82);
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.18s ease, background-color 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
    user-select: none;
}

.rz-role-option__label:hover {
    border-color: rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.035);
}

.rz-role-option__input:checked + .rz-role-option__label {
    border-color: rgba(13, 110, 253, 0.35);
    background: rgba(13, 110, 253, 0.14);
    color: #dbeafe;
    box-shadow: inset 0 0 0 1px rgba(13, 110, 253, 0.18);
}

.rz-role-option__input:focus-visible + .rz-role-option__label {
    outline: 2px solid rgba(110, 168, 254, 0.55);
    outline-offset: 2px;
}
</style>
{% endblock %}

{% block javascript %}
    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const userModalEl = document.getElementById('rz-user-modal');
            const userModalContent = document.getElementById('rz-user-modal-content');
            const newBtnMain = document.getElementById('rz-user-new-btn');
            const newBtnEmpty = document.getElementById('rz-user-new-btn-empty');

            const bsModal = userModalEl ? new bootstrap.Modal(userModalEl) : null;

            function initUserFormAjax() {
                const newForm = document.getElementById('rz-user-new-form');
                if (newForm) {
                    wireUserForm(newForm, 'rz-user-new-submit', 'Utilisateur créé avec succès.');
                }

                const editForm = document.getElementById('rz-user-edit-form');
                if (editForm) {
                    wireUserForm(editForm, 'rz-user-edit-submit', 'Utilisateur mis à jour avec succès.');
                }
            }

            function wireUserForm(form, submitId, defaultSuccessMessage) {
                const submitBtn = document.getElementById(submitId);

                form.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    if (submitBtn) {
                        submitBtn.disabled = true;
                    }

                    form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
                    form.querySelectorAll('.invalid-feedback').forEach(el => el.remove());

                    try {
                        const response = await fetch(form.action, {
                            method: form.method || 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                            },
                            body: new FormData(form),
                        });

                        const data = await response.json();

                        if (!response.ok || data.status !== 'ok') {
                            if (data.errors) {
                                Object.entries(data.errors).forEach(([fieldName, messages]) => {
                                    const field = form.querySelector('[name$="[' + fieldName + ']"]');
                                    if (!field) {
                                        return;
                                    }
                                    field.classList.add('is-invalid');

                                    const feedback = document.createElement('div');
                                    feedback.classList.add('invalid-feedback');
                                    feedback.innerText = messages.join('\n');

                                    if (field.parentNode) {
                                        field.parentNode.appendChild(feedback);
                                    }
                                });
                            }

                            rzShowToast('error', data.message || 'Des erreurs de validation sont présentes.');
                            return;
                        }

                        rzShowToast('success', data.message || defaultSuccessMessage);

                        if (userModalEl && bsModal) {
                            bsModal.hide();
                        }

                        location.reload();
                    } catch (e) {
                        console.error(e);
                        rzShowToast('error', 'Erreur réseau lors de la sauvegarde de l’utilisateur.');
                    } finally {
                        if (submitBtn) {
                            submitBtn.disabled = false;
                        }
                    }
                });
            }

            const statusButtons = document.querySelectorAll('.rz-user-toggle-status-btn');

            statusButtons.forEach((btn) => {
                btn.addEventListener('click', async function () {
                    const userId = this.dataset.userId;
                    const url = this.dataset.url;
                    const token = this.dataset.token;

                    this.disabled = true;

                    try {
                        const response = await fetch(url, {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Content-Type': 'application/x-www-form-urlencoded',
                            },
                            body: new URLSearchParams({
                                _token: token,
                            }),
                        });

                        const data = await response.json();

                        if (!response.ok || data.status !== 'ok') {
                            rzShowToast('error', data.message || 'Une erreur est survenue lors de la mise à jour.');
                            return;
                        }

                        const isActive = data.isActive === true;
                        const statusCell = document.querySelector('[data-user-status-cell="' + userId + '"]');

                        if (statusCell) {
                            statusCell.innerHTML = isActive
                                ? '<span class="badge text-bg-success">Oui</span>'
                                : '<span class="badge text-bg-secondary">Non</span>';
                        }

                        this.classList.toggle('btn-outline-warning', isActive);
                        this.classList.toggle('btn-outline-success', !isActive);
                        this.setAttribute('title', isActive ? 'Désactiver l’utilisateur' : 'Activer l’utilisateur');
                        this.innerHTML = isActive
                            ? '<i class="bi bi-person-x"></i>'
                            : '<i class="bi bi-person-check"></i>';

                        rzShowToast('success', data.message || 'Statut mis à jour avec succès.');
                    } catch (e) {
                        console.error(e);
                        rzShowToast('error', 'Erreur réseau lors de la mise à jour du statut utilisateur.');
                    } finally {
                        this.disabled = false;
                    }
                });
            });

            function wireNewButton(btn) {
                if (!btn) return;
                btn.addEventListener('click', async function () {
                    const url = this.dataset.url;
                    if (!userModalEl || !userModalContent || !bsModal) return;

                    try {
                        const response = await fetch(url, {
                            method: 'GET',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        const html = await response.text();
                        userModalContent.innerHTML = html;
                        bsModal.show();
                        initUserFormAjax();
                    } catch (e) {
                        console.error(e);
                        rzShowToast('error', 'Impossible de charger le formulaire de création.');
                    }
                });
            }

            wireNewButton(newBtnMain);
            wireNewButton(newBtnEmpty);

            document.querySelectorAll('.rz-user-edit-btn').forEach((btn) => {
                btn.addEventListener('click', async function () {
                    const url = this.dataset.url;
                    if (!userModalEl || !userModalContent || !bsModal) return;

                    try {
                        const response = await fetch(url, {
                            method: 'GET',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        const html = await response.text();
                        userModalContent.innerHTML = html;
                        bsModal.show();
                        initUserFormAjax();
                    } catch (e) {
                        console.error(e);
                        rzShowToast('error', 'Impossible de charger le formulaire de modification.');
                    }
                });
            });
        });

        document.addEventListener('click', function (event) {
            const addButton = event.target.closest('[data-add-item]');
            if (addButton) {
                const holder = addButton.closest('.rz-card-body').querySelector('[data-collection-holder]');
                let index = parseInt(holder.dataset.index, 10);

                if (Number.isNaN(index)) {
                    index = holder.querySelectorAll('[data-collection-item]').length;
                }

                const prototype = holder.dataset.prototype.replace(/__name__/g, index);

                const wrapper = document.createElement('div');
                wrapper.className = 'rz-user-society-table__row';
                wrapper.setAttribute('data-collection-item', 'true');
                wrapper.innerHTML = prototype;

                const emptyState = holder.querySelector('.rz-user-societies-empty');
                if (emptyState) {
                    emptyState.remove();
                }

                holder.appendChild(wrapper);
                holder.dataset.index = index + 1;
            }

            const removeButton = event.target.closest('[data-remove-item]');
            if (removeButton) {
                const item = removeButton.closest('[data-collection-item]');
                if (item) {
                    const holder = item.closest('[data-collection-holder]');
                    item.remove();

                    if (holder && holder.querySelectorAll('[data-collection-item]').length === 0) {
                        holder.innerHTML = `
                            <div class="rz-user-societies-empty">
                                <div>
                                    <div class="rz-user-societies-empty__title">Aucune société affectée</div>
                                    <div class="rz-user-societies-empty__text">
                                        Ajoutez une première société pour limiter le périmètre visible par cet utilisateur.
                                    </div>
                                </div>
                            </div>
                        `;
                    }
                }
            }
        });
    </script>
{% endblock %}
