<form method="post"
      action="{{ path('app_referential_delete', {'id': referential.id}) }}"
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce référentiel ?');"
      class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ referential.id) }}">
    <button class="btn btn-outline-danger btn-sm">
        <i class="bi bi-trash"></i>
    </button>
</form>
