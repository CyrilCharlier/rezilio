{% extends 'layout/admin.html.twig' %}

{% block title %}Nouveau référentiel{% endblock %}

{% block content %}
<div class="rz-page">
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h3 class="mb-0">Nouveau référentiel</h3>
                    <p class="rz-page-intro">
                        Créez un référentiel pour structurer vos exigences, vos mesures et vos futures campagnes de revue.
                    </p>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end mb-0">
                        <li class="breadcrumb-item">
                            <a href="{{ path('app_dashboard') }}">Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="{{ path('app_referential_index') }}">Référentiels</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            Nouveau
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">
            {{ include('referential/_form.html.twig', {
                button_label: 'Enregistrer',
                back_path: path('app_referential_index'),
                card_title: 'Informations du référentiel',
                card_icon: 'bi-tags'
            }) }}
        </div>
    </div>
</div>
{% endblock %}
