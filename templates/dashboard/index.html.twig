{% extends 'layout/admin.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block content %}
<div class="rz-page rz-dashboard-page">
    <div class="rz-dashboard-head">
        <div class="rz-page-intro">
            <h1 class="h3 mb-1">Dashboard</h1>

            {% if overview.campaign %}
                <p class="mb-0">
                    {{ overview.campaign.name }}
                    {% if overview.referential %} · {{ overview.referential.label }}{% endif %}
                    {% if overview.society %} · {{ overview.society.name }}{% endif %}
                </p>
            {% else %}
                <p class="mb-0">Aucune campagne accessible.</p>
            {% endif %}
        </div>

        {% if campaigns is not empty %}
            <div class="rz-page-actions rz-dashboard-head-actions">
                <form method="get" action="{{ path('app_dashboard') }}" class="rz-dashboard-inline-filter">
                    <label for="campaign" class="visually-hidden">Campagne</label>

                    <select
                        id="campaign"
                        name="campaign"
                        class="form-select rz-form-select"
                        onchange="this.form.submit()"
                    >
                        {% for campaign in campaigns %}
                            <option value="{{ campaign.id }}"
                                {% if selectedCampaign and campaign.id == selectedCampaign.id %}selected{% endif %}>
                                {{ campaign.name }}
                                {% if campaign.society %} · {{ campaign.society.name }}{% endif %}
                                {% if campaign.referential %} · {{ campaign.referential.label }}{% endif %}
                            </option>
                        {% endfor %}
                    </select>
                </form>
            </div>
        {% endif %}
    </div>

    <div class="row g-2">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="rz-card h-100">
                <div class="rz-card-header">
                    <h3 class="rz-card-header-title mb-0">
                        <i class="bi bi-shield-check"></i>
                        Conformité globale
                    </h3>
                </div>
                <div class="rz-card-body">
                    <div class="display-5 fw-bold">{{ overview.globalScore|number_format(1, ',', ' ') }}%</div>
                    <p class="mb-0 text-muted">
                        {{ overview.implementedCount }} mesure{{ overview.implementedCount > 1 ? 's' : '' }}
                        conforme{{ overview.implementedCount > 1 ? 's' : '' }} sur {{ overview.totalCount }}
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="rz-card h-100">
                <div class="rz-card-header">
                    <h3 class="rz-card-header-title mb-0">
                        <i class="bi bi-check2-circle"></i>
                        Mesures conformes
                    </h3>
                </div>
                <div class="rz-card-body">
                    <div class="display-5 fw-bold">{{ overview.implementedCount }}</div>
                    <p class="mb-0 text-muted">
                        Référentiel de {{ overview.totalCount }} mesures
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="rz-card h-100">
                <div class="rz-card-header">
                    <h3 class="rz-card-header-title mb-0">
                        <i class="bi bi-exclamation-triangle"></i>
                        Actions en retard
                    </h3>
                </div>
                <div class="rz-card-body">
                    <div class="display-5 fw-bold">{{ overview.remediationMetrics.overdue }}</div>
                    <p class="mb-0 text-muted">
                        {{ overview.remediationMetrics.open + overview.remediationMetrics.in_progress }} action(s) ouverte(s) ou en cours
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="rz-card h-100">
                <div class="rz-card-header">
                    <h3 class="rz-card-header-title mb-0">
                        <i class="bi bi-calendar-event"></i>
                        Prochaine échéance
                    </h3>
                </div>
                <div class="rz-card-body">
                    {% if overview.nextDeadline %}
                        <div class="fs-5 fw-bold">{{ overview.nextDeadline.dueDate|date('d/m/Y') }}</div>
                        <p class="mb-0 text-muted">{{ overview.nextDeadline.title }}</p>
                    {% else %}
                        <div class="fs-5 fw-bold">Aucune</div>
                        <p class="mb-0 text-muted">Pas d’action planifiée</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% set totalStatuses = 0 %}
    {% for item in overview.statusChart %}
        {% set totalStatuses = totalStatuses + item.value %}
    {% endfor %}

    <div class="row g-2 mt-2">
        <div class="col-12 col-xl-7">
            <div class="rz-card h-100">
                <div class="rz-card-header">
                    <h3 class="rz-card-header-title mb-0">
                        <i class="bi bi-pie-chart"></i>
                        Répartition des statuts
                    </h3>
                </div>
                <div class="rz-card-body">
                    <p class="rz-table-subtitle mb-3">
                        Répartition des mesures évaluées par statut de conformité.
                    </p>

                    {% if totalStatuses > 0 %}
                        <div class="d-flex flex-column gap-3">
                            {% for item in overview.statusChart %}
                                {% set percent = item.value > 0 ? (item.value / totalStatuses * 100) : 0 %}
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-semibold">{{ item.label }}</span>
                                        <span class="rz-table-subtitle">
                                            {{ item.value }} · {{ percent|number_format(1, ',', ' ') }}%
                                        </span>
                                    </div>

                                    <div class="progress" style="height: 12px;">
                                        <div
                                            class="progress-bar"
                                            role="progressbar"
                                            style="width: {{ percent }}%; background-color: {{ item.color }};"
                                            aria-valuenow="{{ percent }}"
                                            aria-valuemin="0"
                                            aria-valuemax="100"
                                            aria-label="{{ item.label }} : {{ percent|number_format(1, ',', ' ') }}%"
                                        ></div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="mb-0 text-muted">Aucune donnée de revue disponible pour cette campagne.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="rz-card h-100">
                <div class="rz-card-header">
                    <h3 class="rz-card-header-title mb-0">
                        <i class="bi bi-bar-chart"></i>
                        Domaines les plus faibles
                    </h3>
                </div>
                <div class="rz-card-body">
                    <p class="rz-table-subtitle mb-3">
                        Classement des catégories ayant le plus faible taux de conformité sur la campagne sélectionnée.
                    </p>

                    {% if overview.weakestCategories is not empty %}
                        <div class="d-flex flex-column gap-3">
                            {% for category in overview.weakestCategories %}
                                <div>
                                    <div class="d-flex justify-content-between align-items-start gap-3 mb-1">
                                        <div class="min-w-0">
                                            <div class="fw-semibold">{{ category.name }}</div>
                                            <div class="rz-table-subtitle">
                                                {{ category.compliant }}/{{ category.total }} mesures conformes · {{ category.toneLabel }}
                                            </div>
                                        </div>
                                        <div class="fw-semibold text-nowrap">
                                            {{ category.score|number_format(1, ',', ' ') }}%
                                        </div>
                                    </div>

                                    <div class="progress" style="height: 10px;">
                                        <div
                                            class="progress-bar"
                                            role="progressbar"
                                            style="width: {{ category.score }}%; background-color: {{ category.color }}; min-width: 20px;"
                                            aria-valuenow="{{ category.score }}"
                                            aria-valuemin="0"
                                            aria-valuemax="100"
                                            aria-label="{{ category.name }} : {{ category.score|number_format(1, ',', ' ') }}%"
                                        ></div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="mb-0 text-muted">Aucune catégorie exploitable pour cette campagne.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mt-2">
        <div class="col-12">
            <div class="rz-card">
                <div class="rz-card-header">
                    <h3 class="rz-card-header-title mb-0">
                        <i class="bi bi-list-check"></i>
                        Actions prioritaires
                    </h3>
                </div>
                <div class="rz-card-body">
                    <p class="rz-table-subtitle mb-3">
                        Actions de remédiation les plus critiques à traiter sur la campagne sélectionnée.
                    </p>

                    {% if overview.priorityActions is not empty %}
                        <div class="rz-table-wrap">
                            <table class="rz-table">
                                <thead>
                                    <tr>
                                        <th>Action</th>
                                        <th>Priorité</th>
                                        <th>Statut</th>
                                        <th>Échéance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for action in overview.priorityActions %}
                                        {% set isOverdue = action.dueDate and action.dueDate|date('U') < 'now'|date('U') %}

                                        <tr>
                                            <td>
                                                <div class="rz-table-title">{{ action.title }}</div>

                                                {% if action.measureReview and action.measureReview.measure %}
                                                    <div class="rz-table-subtitle">
                                                        {{ action.measureReview.measure.code }} · {{ action.measureReview.measure.label }}
                                                    </div>
                                                {% endif %}
                                            </td>

                                            <td>
                                                <span class="badge rz-badge {{ action.priority.badgeClass }}">
                                                    {{ action.priority.label }}
                                                </span>
                                            </td>

                                            <td>
                                                <span class="badge rz-badge {{ action.status.badgeClass }}">
                                                    {{ action.status.label }}
                                                </span>
                                            </td>

                                            <td>
                                                {% if action.dueDate %}
                                                    <div class="rz-table-title">{{ action.dueDate|date('d/m/Y') }}</div>
                                                    <div class="rz-table-subtitle {{ isOverdue ? 'text-danger' : '' }}">
                                                        {{ isOverdue ? 'Échue' : 'À venir' }}
                                                    </div>
                                                {% else %}
                                                    <span class="rz-table-subtitle">Non définie</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="mb-0 text-muted">Aucune action prioritaire pour cette campagne.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
