{% extends 'layout/admin.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block content %}
<div class="rz-page">
    <div class="rz-page-intro mb-4">
        <h1 class="h3 mb-1">Dashboard</h1>

        {% if overview.campaign %}
            <p class="mb-0">
                {{ overview.campaign.name }}
                {% if overview.referential %} · {{ overview.referential.label }}{% endif %}
                {% if overview.society %} · {{ overview.society.name }}{% endif %}
            </p>
        {% else %}
            <p class="mb-0">Aucune campagne accessible.</p>
        {% endif %}
    </div>

    {% if campaigns is not empty %}
    <div class="rz-card mb-4">
        <div class="rz-card-body">
            <form method="get" action="{{ path('app_dashboard') }}" class="row g-3 align-items-end">
                <div class="col-12 col-md-6 col-xl-4">
                    <label for="campaign" class="form-label">Campagne</label>
                    <select id="campaign" name="campaign" class="form-select" onchange="this.form.submit()">
                        {% for campaign in campaigns %}
                            <option value="{{ campaign.id }}"
                                {% if selectedCampaign and campaign.id == selectedCampaign.id %}selected{% endif %}>
                                {{ campaign.name }}
                                {% if campaign.society %} · {{ campaign.society.name }}{% endif %}
                                {% if campaign.referential %} · {{ campaign.referential.label }}{% endif %}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-12 col-md-auto">
                    <button type="submit" class="btn btn-primary">Appliquer</button>
                </div>
            </form>
        </div>
    </div>
    {% endif %}

    <div class="row g-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="rz-card h-100">
                <div class="rz-card-header">
                    <h2 class="rz-card-header-title mb-0">Score de maturité global</h2>
                </div>
                <div class="rz-card-body">
                    <div class="display-6 fw-bold">{{ overview.globalScore }}%</div>
                    <p class="text-muted mb-0">
                        {{ overview.implementedCount }} conforme{{ overview.implementedCount > 1 ? 's' : '' }}
                        sur {{ overview.totalCount }}
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="rz-card h-100">
                <div class="rz-card-header">
                    <h2 class="rz-card-header-title mb-0">Mesures conformes</h2>
                </div>
                <div class="rz-card-body">
                    <div class="display-6 fw-bold">{{ overview.implementedCount }}</div>
                    <p class="text-muted mb-0">
                        Sur {{ overview.totalCount }} mesures évaluables
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="rz-card h-100">
                <div class="rz-card-header">
                    <h2 class="rz-card-header-title mb-0">Actions en retard</h2>
                </div>
                <div class="rz-card-body">
                    <div class="display-6 fw-bold">{{ overview.remediationMetrics.overdue }}</div>
                    <p class="text-muted mb-0">
                        {{ overview.remediationMetrics.open + overview.remediationMetrics.in_progress }} action(s) ouverte(s) ou en cours
                    </p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="rz-card h-100">
                <div class="rz-card-header">
                    <h2 class="rz-card-header-title mb-0">Prochaine échéance</h2>
                </div>
                <div class="rz-card-body">
                    {% if overview.nextDeadline %}
                        <div class="fw-bold fs-5">{{ overview.nextDeadline.dueDate|date('d/m/Y') }}</div>
                        <p class="text-muted mb-0">
                            {{ overview.nextDeadline.title }}
                        </p>
                    {% else %}
                        <div class="fw-bold fs-5">Aucune</div>
                        <p class="text-muted mb-0">
                            Pas d’action planifiée
                        </p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
