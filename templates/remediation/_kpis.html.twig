<div class="row g-3 mb-4">
    <div class="col-12 col-md-6 col-xl-2">
        <div class="card rz-card h-100">
            <div class="card-body rz-card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-body-secondary small">Total</div>
                        <div class="fs-3 fw-semibold">{{ metrics.total }}</div>
                    </div>
                    <span class="badge text-bg-secondary">
                        <i class="bi bi-list-task"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-2">
        <div class="card rz-card h-100">
            <div class="card-body rz-card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-body-secondary small">Ouvertes</div>
                        <div class="fs-3 fw-semibold">{{ metrics.open }}</div>
                    </div>
                    <span class="badge text-bg-primary">
                        <i class="bi bi-folder2-open"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-2">
        <div class="card rz-card h-100">
            <div class="card-body rz-card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-body-secondary small">En cours</div>
                        <div class="fs-3 fw-semibold">{{ metrics.in_progress }}</div>
                    </div>
                    <span class="badge text-bg-warning">
                        <i class="bi bi-arrow-repeat"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-2">
        <div class="card rz-card h-100">
            <div class="card-body rz-card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-body-secondary small">Terminées</div>
                        <div class="fs-3 fw-semibold">{{ metrics.done }}</div>
                    </div>
                    <span class="badge text-bg-success">
                        <i class="bi bi-check2-circle"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-2">
        <div class="card rz-card h-100">
            <div class="card-body rz-card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-body-secondary small">En retard</div>
                        <div class="fs-3 fw-semibold">{{ metrics.overdue }}</div>
                    </div>
                    <span class="badge text-bg-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-2">
        <div class="card rz-card h-100">
            <div class="card-body rz-card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-body-secondary small">Brouillons</div>
                        <div class="fs-3 fw-semibold">{{ metrics.draft }}</div>
                    </div>
                    <span class="badge text-bg-secondary">
                        <i class="bi bi-file-earmark-text"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>
