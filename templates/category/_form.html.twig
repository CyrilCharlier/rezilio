{{ form_start(form, {
    attr: {
        action: action_path ?? path('app_category_new_for_referential', {'id': referential.id}),
        class: 'form-horizontal js-category-form'
    }
}) }}

  <div class="mb-3">
    {{ form_label(form.name, null, {'label_attr': {'class': 'form-label'}}) }}
    {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
    {{ form_errors(form.name) }}
  </div>

  <div class="mb-3">
    {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 3}}) }}
    {{ form_errors(form.description) }}
  </div>

  <div class="row mb-3">
    <div class="col-md-6">
      {{ form_label(form.ordre, null, {'label_attr': {'class': 'form-label'}}) }}
      {{ form_widget(form.ordre, {'attr': {'class': 'form-control'}}) }}
      {{ form_errors(form.ordre) }}
    </div>

    <div class="col-md-6 d-flex align-items-end">
      <div class="btn-group" role="group" aria-label="Statut catégorie">
        {{ form_widget(form.active, {
          attr: {
            class: 'btn-check',
            autocomplete: 'off'
          }
        }) }}
        <label class="btn btn-outline-info"
               for="{{ form.active.vars.id }}">
            Active
        </label>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-end gap-2">
    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
      Annuler
    </button>
    <button class="btn btn-primary btn-sm">
      {{ submit_label|default('Enregistrer') }}
    </button>
  </div>
{{ form_end(form) }}
