{% extends 'layout/admin.html.twig' %}

{% block title %}Edit Category{% endblock %}

{% block content %}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Category</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="{{ path('app_default')}}">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Category index</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="app-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12">

                    {{ include('category/_form.html.twig') }}

                    <div class="mt-3">
                        <div class="card border-danger-subtle">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1 text-danger">
                                    Zone de danger
                                    </h6>
                                    <p class="mb-0 text-body-secondary small">
                                    La suppression de cette catégorie est définitive.
                                    </p>
                                </div>
                                <div>
                                    {{ include('category/_delete_form.html.twig') }}
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>


{% endblock %}
