{% extends 'layout/admin.html.twig' %}

{% block title %}Category index{% endblock %}

{% block content %}
  <div class="app-content-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-6">
          <h3 class="mb-0">Catégories</h3>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item">
              <a href="{{ path('app_default') }}">Home</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
              Category index
            </li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <div class="app-content">
    <div class="container-fluid">
      <div class="row">
        <div class="col-lg-12">

          <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <h3 class="card-title mb-0">
                <i class="bi bi-tags me-2"></i> Liste des catégories
              </h3>
              <a href="{{ path('app_category_new') }}" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg"></i> Nouvelle catégorie
              </a>
            </div>

            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                  <thead class="table-dark">
                    <tr>
                      <th style="width: 80px;">ID</th>
                      <th>Référentiel</th>
                      <th>Ordre</th>
                      <th>Nom</th>
                      <th>Description</th>
                      <th>Actif</th>
                      <th class="text-end" style="width: 120px;">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for category in categories %}
                      <tr>
                        <td class="text-body-secondary">{{ category.id }}</td>
                        <td class="text-body-secondary">
                            {% if category.referential %}
                            {{ category.referential.code }} – {{ category.referential.label }}
                            {% else %}
                            <span class="text-body-secondary">—</span>
                            {% endif %}
                        </td>
                        <td class="text-body-secondary">
                            {{ category.ordre ?? '—' }}
                        </td>
                        <td>{{ category.name }}</td>
                        <td class="text-body-secondary">
                          {{ category.description ?: '—' }}
                        </td>
                        <td>
                          {% if category.active %}
                          <span class="badge text-bg-success">Oui</span>
                          {% else %}
                          <span class="badge text-bg-secondary">Non</span>
                          {% endif %}
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex align-items-center gap-1">
                                <a href="{{ path('app_category_edit', {'id': category.id}) }}"
                                class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-pencil-square"></i>
                                </a>

                                {{ include('category/_delete_form.html.twig') }}
                            </div>
                        </td>
                      </tr>
                    {% else %}
                      <tr>
                        <td colspan="4" class="text-center text-body-secondary py-4">
                          Aucune catégorie pour le moment.
                        </td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
{% endblock %}
